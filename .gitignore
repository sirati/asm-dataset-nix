# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*
.multiversion-work/

# Ignore automatically generated direnv output
.direnv

# Test artifacts
test_results.jsonl

.cross-results/
nix-upstream/

# Python bytecode
__pycache__/
*.pyc

# Ephemeral ssh-debug keypair (private key) — see python/ssh_debug_runner/.
# Pubkey is intentionally tracked so the Nix image build can read it.
.ssh-debug/id_ed25519
.ssh-debug/known_hosts

# Claude Code per-session scratch (worktrees, transcripts).
.claude/

# Local work-in-progress notes; not part of the dataset.
transformer_spec.md

# Compiler capture experiments and local Rust artifacts.
.capture-experiments/
rust/compiler-capture/target/

# template_graph probe caches (auto-generated, large, easily regenerated).
template_graph/tests/fixtures/.probe_cache*.json
template_graph/tests/fixtures/.probe_cache*.json.backup*
