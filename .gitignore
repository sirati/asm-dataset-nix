# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Test artifacts
test_results.jsonl

.cross-results/
nix-upstream/

# Python bytecode
__pycache__/
*.pyc

# Ephemeral ssh-debug keypair (private key) — see python/ssh_debug_runner/.
# Pubkey is intentionally tracked so the Nix image build can read it.
.ssh-debug/id_ed25519
.ssh-debug/known_hosts
